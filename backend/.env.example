# Backend Environment Variables Template
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Phase 3: Supabase PostgreSQL Connection (Supavisor Session Mode on Port 5432 for IPv4 support)
# Format: postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Phase 4: Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
